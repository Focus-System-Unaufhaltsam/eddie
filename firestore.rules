rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validPlayerDocId(docId) {
      return signedIn()
        && docId == ('PLAYER_' + request.auth.uid);
    }

    function validName() {
      return request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Z0-9_]{2,15}$');
    }

    function validPlatform() {
      return request.resource.data.platform in [
        'AUTO',
        'TIKTOK',
        'INSTAGRAM',
        'YOUTUBE',
        'X',
        'LINKEDIN',
        'TWITCH',
        'OTHER'
      ];
    }

    function validHandle() {
      return request.resource.data.socialHandle is string
        && request.resource.data.socialHandle.matches('^[A-Za-z0-9._]{2,30}$');
    }

    function validSocialDisplay() {
      return request.resource.data.socialDisplay is string
        && request.resource.data.socialDisplay.size() >= 3
        && request.resource.data.socialDisplay.size() <= 31;
    }

    function validSocialKey(docId) {
      return request.resource.data.socialKey is string
        && request.resource.data.socialKey == docId
        && request.resource.data.docId == docId
        && validPlayerDocId(docId);
    }

    function validScore() {
      return request.resource.data.score is int
        && request.resource.data.score >= 4
        && request.resource.data.score <= 30;
    }

    function validRounds() {
      return request.resource.data.rounds is int
        && request.resource.data.rounds >= 1
        && request.resource.data.rounds <= 29;
    }

    function validTime() {
      return request.resource.data.time is number
        && request.resource.data.time >= 1
        && request.resource.data.time <= 900;
    }

    function validSession() {
      return request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() >= 16
        && request.resource.data.sessionId.size() <= 64;
    }

    function validClientVersion() {
      return request.resource.data.clientVersion is string
        && request.resource.data.clientVersion.size() >= 1
        && request.resource.data.clientVersion.size() <= 80;
    }

    function validUserAgent() {
      return request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 160;
    }

    function validTimestamp() {
      return request.resource.data.timestamp == request.time;
    }

    function validLeaderboardDoc(docId) {
      return request.resource.data.keys().hasOnly([
          'name',
          'platform',
          'socialHandle',
          'socialDisplay',
          'docId',
          'socialKey',
          'score',
          'time',
          'rounds',
          'sessionId',
          'clientVersion',
          'userAgent',
          'timestamp'
        ])
        && validName()
        && validPlatform()
        && validHandle()
        && validSocialDisplay()
        && validSocialKey(docId)
        && validScore()
        && validRounds()
        && validTime()
        && validSession()
        && validClientVersion()
        && validUserAgent()
        && validTimestamp();
    }

    function validAmazonProductClick(docId) {
      return signedIn()
        && docId.matches('^CLICK_[a-z0-9]{24}$')
        && request.resource.data.keys().hasOnly([
          'event_name',
          'asin',
          'source',
          'destination',
          'test_event',
          'client_version',
          'timestamp'
        ])
        && request.resource.data.event_name == 'amazon_product_click'
        && request.resource.data.asin == 'B0H7KX8XF4'
        && request.resource.data.source in ['hq', 'game']
        && request.resource.data.destination == 'https://www.amazon.de/dp/B0H7KX8XF4'
        && request.resource.data.test_event is bool
        && request.resource.data.client_version == 'amazon-outbound-v1'
        && request.resource.data.timestamp == request.time;
    }

    // 1. LEADERBOARD
    // Öffentlich lesbar, Schreiben nur validiert und nur ins eigene PLAYER-Dokument.
    match /leaderboard_eddie-v1/{docId} {
      allow read: if true;

      allow create: if signedIn()
        && validLeaderboardDoc(docId);

      allow update: if signedIn()
        && validLeaderboardDoc(docId)
        && resource.data.docId == docId
        && resource.data.socialKey == docId
        && request.resource.data.socialKey == resource.data.socialKey
        && request.resource.data.docId == resource.data.docId
        && (
          request.resource.data.score > resource.data.score ||
          (
            request.resource.data.score == resource.data.score &&
            request.resource.data.time < resource.data.time
          )
        );

      allow delete: if false;
    }

    // 2. ARCHIVE SELECTIONS
    // Öffentlich lesbar, Keeps nur kontrolliert hochzählbar.
    match /archive_selections/{logId} {
      allow read: if true;

      allow create: if signedIn()
        && logId.matches('^raw-log-[0-9]{3}$')
        && request.resource.data.keys().hasOnly([
          'logId',
          'keeps',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.logId == logId
        && request.resource.data.keeps is int
        && request.resource.data.keeps == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && logId.matches('^raw-log-[0-9]{3}$')
        && request.resource.data.keys().hasOnly([
          'logId',
          'keeps',
          'createdAt',
          'updatedAt'
        ])
        && resource.data.logId == logId
        && request.resource.data.logId == resource.data.logId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keeps is int
        && resource.data.keeps is int
        && request.resource.data.keeps == resource.data.keeps + 1;

      allow delete: if false;
    }

    // 3. ARTIFACTS
    // App-Konfigurationen / öffentliche Artefakte: Lesen erlaubt, Schreiben aus dem Browser verboten.
    match /artifacts/{artifactId} {
      allow read: if true;
      allow write: if false;
    }

    // 4. GLOBAL STATS
    // Öffentliche Statistikwerte: Lesen erlaubt, Schreiben aus dem Browser verboten.
    match /stats_leaderboard_eddie-v1/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 5. AMAZON PRODUCT CLICKS
    // Privacy-safe funnel evidence; never a sale or conversion.
    match /amazon_product_clicks/{docId} {
      allow read: if true;
      allow create: if validAmazonProductClick(docId);
      allow update, delete: if false;
    }

    // 6. CATCH-ALL
    // Alles andere bleibt dicht.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
